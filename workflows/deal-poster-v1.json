    {
      "parameters": {
        "jsCode": "const res = $json.results || [];\nreturn res.map(p => {\n  const name = (p.properties['สินค้า'].title || []).map(t => t.plain_text).join('');\n  const link = p.properties['ลิงก์Affiliate'] ? p.properties['ลิงก์Affiliate'].url : '';\n  let caption = (p.properties['แคปชัน'] && p.properties['แคปชัน'].rich_text ? p.properties['แคปชัน'].rich_text : []).map(t => t.plain_text).join('');\n  const sale = p.properties['ราคาลด'] ? p.properties['ราคาลด'].number : null;\n  const full = p.properties['ราคาเต็ม'] ? p.properties['ราคาเต็ม'].number : null;\n  if (!caption && name) {\n    let priceLine = '';\n    if (sale) priceLine = '💥 เหลือ ' + sale + ' บาท';\n    else if (full) priceLine = '💰 ราคา ' + full + ' บาท';\n    caption = '✨ ' + name + '\\n' + (priceLine ? priceLine + '\\n' : '') + '👉 ' + link + '\\n\\n#ป้ายยา #ดีลเด็ด (ลิงก์ affiliate)';\n  }\n  return { json: { page_id: p.id, name: name, link: link, caption: caption } };\n}).filter(i => i.json.caption && i.json.link).slice(0, 6);"
      },
