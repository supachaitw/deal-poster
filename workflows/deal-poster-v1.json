      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d=$('Split Approved').item.json;\nlet img=null;\ntry{\n  const j=$input.item.json;\n  const html=typeof j.data==='string'?j.data:(typeof j.body==='string'?j.body:'');\n  const m=html.match(/property=\"og:image\" content=\"([^\"]{10,500})\"/);\n  if(m)img=m[1].replace(/&amp;/g,'&');\n}catch(e){}\nreturn { json: { caption:d.caption||'', photoUrl:img } };"
      },
