    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const deal = $('Split Approved').item.json;\nconst all = $('Split Approved').all().map(x => x.json);\nconst idx = all.findIndex(a => a.page_id === deal.page_id);\nfunction pick(node, i){ try { const arr = $(node).all(); return (i >= 0 && arr[i]) ? arr[i].json : null; } catch (e) { return null; } }\nfunction errOf(j){ try { const m = (j && j.error && (j.error.message || j.error.error_user_msg)) || (j && j.message) || ''; return String(m).replace(/\\s+/g, ' ').slice(0, 70); } catch (e) { return ''; } }\n\nlet tg = '❌ ไม่สำเร็จ';\nconst tv = pick('TG Verify', idx);\nif (tv && tv.sent === true) tg = '✅ รูป+แคปชัน';\nelse if (tv && tv.sent === false) tg = '⚠️ ข้อความล้วน (รูปไม่ผ่าน)';\n\nlet fb = '❌ ไม่สำเร็จ';\nconst fv = pick('FB Verify', idx);\nif (fv && fv.sent === true) fb = '✅ รูป+แคปชัน';\nelse if (fv && fv.sent === false) fb = '⚠️ ข้อความ+ลิงก์ (รูปไม่ผ่าน)';\n\nlet thj = null;\ntry { thj = $('Threads Publish').item.json; } catch (e) { thj = pick('Threads Publish', idx); }\nlet th;\nif (thj && thj.id) {\n  let mode = '';\n  try { mode = $('Build Threads Post').item.json.mode || ''; } catch (e) {}\n  th = (mode === 'TEXT') ? '✅ ข้อความล้วน' : '✅ รูป+แคปชัน';\n} else {\n  const m = errOf(thj);\n  th = '❌ ไม่สำเร็จ' + (m ? ' — ' + m : '');\n}\n\nconst text = '✅ โพสต์แล้ว: ' + (deal.name || '-') + '\\n' +\n  '• Telegram: ' + tg + '\\n' +\n  '• Facebook: ' + fb + '\\n' +\n  '• Threads: ' + th +\n  (deal.link ? '\\n' + deal.link : '');\nreturn { json: { alert: text, name: deal.name } };"
      },
