        "jsCode": "const d=$('Split Approved').item.json;\nlet img=null;\ntry{\n  const imgs=$json.images;\n  if(Array.isArray(imgs)&&imgs.length){\n    const big=imgs.slice().sort((a,b)=>(b.width||0)-(a.width||0))[0];\n    if(big&&big.source)img=big.source;\n  }\n}catch(e){}\nlet text=(d.caption||'').trim();\n// IG กดลิงก์ในแคปชันไม่ได้ -> ตัดบรรทัดที่มีลิงก์ทิ้ง\nlet lines=text.split('\\n').filter(l=>l.indexOf('http')===-1);\n// ดึงแฮชแท็กออกจากเนื้อความไปรวมไว้ท้ายโพสต์ที่เดียว + ตัดหมายเหตุ (ลิงก์ affiliate) ที่ไม่มีความหมายบน IG\nconst found=[];\nlines=lines.map(function(l){\n  l=l.replace(/\\(\\s*ลิงก์\\s*affiliate\\s*\\)/g,'');\n  const m=l.match(/#[^\\s#]+/g);\n  if(m)m.forEach(function(t){found.push(t);});\n  return l.replace(/#[^\\s#]+/g,'').replace(/[ \\t]+/g,' ').trim();\n});\nlet body=lines.join('\\n').replace(/\\n{3,}/g,'\\n\\n').trim();\nconst cat=(d.cat||'').trim();\nconst base=['#ป้ายยา','#ดีลเด็ด','#ของถูก','#รีวิวของดี','#ช้อปปิ้งออนไลน์'];\nif(cat)base.push('#'+cat.replace(/\\s/g,''));\nconst tags=[];\nfound.concat(base).forEach(function(t){if(tags.indexOf(t)===-1)tags.push(t);});\nlet caption=body+'\\n\\n🔗 กดลิงก์ในไบโอเพื่อไปที่ร้าน\\n\\n'+tags.join(' ');\nif(caption.length>2100)caption=caption.slice(0,2099);\nreturn { json: { igImage:img, igCaption:caption, hasImage:!!img } };"
      },
