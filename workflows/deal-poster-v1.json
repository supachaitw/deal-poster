        "jsCode": "const d=$('Split Approved').item.json;\nconst cap=d.caption||'';\nconst link=(cap.match(/https?:\\/\\/\\S+/)||[''])[0];\nlet body=cap.replace(/👉\\s*https?:\\/\\/\\S+/,'').replace(/#ป้ายยา[^\\n]*/,'').replace(/\\n{3,}/g,'\\n\\n').trim();\nconst budget=280-23-1-25;\nif(body.length>budget)body=body.slice(0,budget-1)+'…';\nconst text=body+'\\n'+link+'\\n#ป้ายยา #ดีลเด็ด';\nreturn { json: { text } };"
