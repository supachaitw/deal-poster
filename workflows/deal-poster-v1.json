    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d=$('Split Approved').item.json;\n\n// รูปจาก Lazada CDN ถูกเสิร์ฟเป็น AVIF (x-oss-process=.../format,avif)\n// Telegram/Facebook/Instagram ไม่รองรับ AVIF -> บังคับให้ CDN คืนเป็น JPEG\nfunction toJpg(u){\n  if(!u) return u;\n  try{\n    if(u.indexOf('x-oss-process')!==-1){\n      u=u.replace(/format,(avif|webp|heic|heif)/gi,'format,jpg');\n      if(!/format,jpg/i.test(u)) u=u+'/format,jpg';\n    }\n    u=u.replace(/\\.(avif|webp)(\\?|$)/i,'$2').replace(/\\.jpg_(\\?|$)/i,'.jpg$1');\n  }catch(e){}\n  return u;\n}\n\nlet img=null;\ntry{\n  const j=$input.item.json;\n  const html=typeof j.data==='string'?j.data:(typeof j.body==='string'?j.body:'');\n  const m=html.match(/property=\"og:image\" content=\"([^\"]{10,500})\"/);\n  if(m)img=m[1].replace(/&amp;/g,'&');\n}catch(e){}\nimg=toJpg(img);\nreturn { json: { caption:d.caption||'', photoUrl:img } };\n"
      },
