    {
      "parameters": {
        "jsCode": "const rows = ($input.first().json.results)||[];\nconst esc = s => String(s==null?'':s).split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;').split('\"').join('&quot;');\nconst num = v => (v==null? null : Number(v));\nconst deals = rows.map(p => {\n  const pr = p.properties||{};\n  const t = ((pr['สินค้า']||{}).title)||[];\n  return {\n    name: t.map(x=>x.plain_text).join('').trim(),\n    link: (pr['ลิงก์Affiliate']||{}).url || '',\n    full: num((pr['ราคาเต็ม']||{}).number),\n    sale: num((pr['ราคาลด']||{}).number),\n    cat : ((pr['หมวด']||{}).select||{}).name || '',\n    when: ((pr['โพสต์เมื่อ']||{}).date||{}).start || '',\n    img : (pr['รูป']||{}).url || ''\n  };\n}).filter(d => d.name && d.link && d.name.indexOf('ทดสอบ') === -1);\nconst money = n => (n==null? '' : Number(n).toLocaleString('th-TH',{maximumFractionDigits:2}));\nconst tn = u => {\n  if(!u || u.indexOf('susercontent.com/file/') < 0) return u;\n  const seg = u.slice(u.lastIndexOf('/')+1);\n  if(seg.indexOf('.') > -1 || seg.slice(-3) === '_tn') return u;\n  return u + '_tn';\n};\nconst cards = deals.map(d => {\n  const off = (d.full && d.sale && d.full > d.sale) ? Math.round((1 - d.sale/d.full)*100) : null;\n  const price = d.sale!=null ? ('<span class=\"now\">' + money(d.sale) + ' ฿</span>' + (d.full!=null&&d.full>d.sale ? ' <span class=\"was\">' + money(d.full) + ' ฿</span>' : '')) : '';\n  const thumb = d.img\n    ? '<img class=\"thumb\" src=\"' + esc(tn(d.img)) + '\" data-o=\"' + esc(d.img) + '\" alt=\"\" loading=\"lazy\" decoding=\"async\" referrerpolicy=\"no-referrer\" onerror=\"if(this.dataset.f){this.remove()}else{this.dataset.f=1;this.src=this.dataset.o}\">'\n    : '';\n  return '<a class=\"card\" href=\"' + esc(d.link) + '\" target=\"_blank\" rel=\"noopener nofollow\">' +\n    (off!=null ? '<span class=\"off\">-' + off + '%</span>' : '') +\n    thumb +\n    '<div class=\"body\">' +\n    (d.cat ? '<span class=\"chip\">' + esc(d.cat) + '</span>' : '') +\n    '<div class=\"name\">' + esc(d.name) + '</div>' +\n    '<div class=\"price\">' + price + '</div>' +\n    '<div class=\"go\">ดูดีล →</div></div></a>';\n}).join('');\nconst page = '<!doctype html><html lang=\"th\"><head><meta charset=\"utf-8\">' +\n  '<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">' +\n  '<title>ป้ายยาดีลเด็ด — รวมดีลล่าสุด</title>' +\n  '<meta name=\"robots\" content=\"noindex\">' +\n  '<style>' +\n  ':root{--bg:#faf6f0;--sf:#fffcf8;--sf2:#f3eadf;--ln:#dfd1bf;--tx:#382c22;--mu:#6f5f51;--ac:#8b5e3c}' +\n  '*{box-sizing:border-box}body{margin:0;padding:20px 14px 48px;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Noto Sans Thai\",sans-serif;color:var(--tx);background:radial-gradient(1200px 600px at 80% -10%,#f1e3d3 0%,transparent 60%),radial-gradient(900px 500px at -10% 110%,#eaddce 0%,transparent 55%),var(--bg)}' +\n  '.wrap{max-width:560px;margin:0 auto}' +\n  'h1{font-size:22px;margin:0 0 4px;display:flex;align-items:center;gap:8px}' +\n  '.sub{color:var(--mu);font-size:14px;margin:0 0 20px}' +\n  '.card{position:relative;display:flex;gap:12px;align-items:flex-start;background:linear-gradient(180deg,var(--sf2),var(--sf));border:1px solid var(--ln);border-left:4px solid var(--ac);border-radius:14px;padding:14px 16px;margin-bottom:12px;text-decoration:none;color:inherit;box-shadow:0 6px 18px rgba(56,44,34,.10)}' +\n  '.card:active{transform:scale(.99)}' +\n  '.chip{display:inline-block;font-size:11px;color:var(--mu);border:1px solid var(--ln);border-radius:99px;padding:2px 9px;margin-bottom:8px}' +\n  '.off{position:absolute;top:12px;right:14px;background:var(--ac);color:#fffcf8;font-size:12px;font-weight:700;border-radius:8px;padding:3px 8px}' +\n  '.body{flex:1;min-width:0}' +\n  '.thumb{flex:0 0 92px;width:92px;height:92px;border-radius:10px;object-fit:cover;background:var(--sf2);border:1px solid var(--ln);display:block}' +\n  '@media(max-width:380px){.thumb{flex-basis:74px;width:74px;height:74px}}' +\n  '.name{font-weight:600;line-height:1.45;margin-bottom:8px;padding-right:52px}' +\n  '.now{font-size:19px;font-weight:800;color:var(--ac)}' +\n  '.was{color:var(--mu);text-decoration:line-through;font-size:13px;margin-left:4px}' +\n  '.go{margin-top:10px;font-size:13px;font-weight:700;color:var(--ac)}' +\n  '.pager{display:none;align-items:center;justify-content:center;gap:12px;margin:18px 0 4px;color:var(--mu);font-size:13px;flex-wrap:wrap}' +\n  '.pager button{font:inherit;font-size:13px;padding:7px 14px;border-radius:9px;cursor:pointer;border:1px solid var(--ln);background:var(--sf);color:var(--tx)}' +\n  '.pager button:hover:not(:disabled){border-color:var(--ac);color:var(--ac)}' +\n  '.pager button:disabled{opacity:.4;cursor:default}' +\n  '.foot{text-align:center;color:var(--mu);font-size:12px;margin-top:24px;line-height:1.8}' +\n  '.empty{color:var(--mu);text-align:center;padding:40px 0}' +\n  '</style></head><body><div class=\"wrap\">' +\n  '<h1>🛒 ป้ายยาดีลเด็ด</h1>' +\n  '<p class=\"sub\">รวมดีลล่าสุด ' + deals.length + ' รายการ · แตะการ์ดเพื่อไปที่ร้าน</p>' +\n  '<div class=\"pager\" id=\"pgTop\"></div>' +\n  (cards || '<div class=\"empty\">ยังไม่มีดีลในตอนนี้</div>') +\n  '<div class=\"pager\" id=\"pgBot\"></div>' +\n  '<p class=\"foot\">ลิงก์ในหน้านี้เป็นลิงก์ affiliate<br>Telegram @paiyaa_deals · Facebook ป้ายยาดีลเด็ด</p>' +\n  '<script>(function(){' +\n  'var PER=50,page=0;' +\n  'var cards=[].slice.call(document.querySelectorAll(\".card\"));' +\n  'var pages=Math.max(1,Math.ceil(cards.length/PER));' +\n  'var bars=[document.getElementById(\"pgTop\"),document.getElementById(\"pgBot\")];' +\n  'function bar(pg){' +\n  'pg.textContent=\"\";' +\n  'var b1=document.createElement(\"button\");b1.textContent=\"\\\\u2039 \\\\u0e22\\\\u0e49\\\\u0e2d\\\\u0e19\\\\u0e2b\\\\u0e25\\\\u0e31\\\\u0e07\";' +\n  'b1.disabled=(page===0);b1.onclick=function(){if(page>0){page--;render();}};' +\n  'var sp=document.createElement(\"span\");' +\n  'sp.textContent=(page*PER+1)+\"-\"+Math.min(cards.length,(page+1)*PER)+\" \\\\u0e08\\\\u0e32\\\\u0e01 \"+cards.length+\" \\\\u00b7 \\\\u0e2b\\\\u0e19\\\\u0e49\\\\u0e32 \"+(page+1)+\"/\"+pages;' +\n  'var b2=document.createElement(\"button\");b2.textContent=\"\\\\u0e16\\\\u0e31\\\\u0e14\\\\u0e44\\\\u0e1b \\\\u203a\";' +\n  'b2.disabled=(page+1>=pages);b2.onclick=function(){if(page+1<pages){page++;render();}};' +\n  'pg.appendChild(b1);pg.appendChild(sp);pg.appendChild(b2);}' +\n  'function render(){' +\n  'for(var i=0;i<cards.length;i++){cards[i].style.display=(i>=page*PER&&i<(page+1)*PER)?\"\":\"none\";}' +\n  'for(var k=0;k<bars.length;k++){if(!bars[k])continue;' +\n  'if(pages<2){bars[k].style.display=\"none\";}else{bars[k].style.display=\"flex\";bar(bars[k]);}}' +\n  'window.scrollTo(0,0);}' +\n  'render();})();</script>' +\n  '</div></body></html>';\nreturn [{ json: { page } }];"
      },
