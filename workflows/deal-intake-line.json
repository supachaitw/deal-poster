    {
      "id": "mg",
      "name": "Merge Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        430,
        -160
      ],
      "parameters": {
        "jsCode": "const info=$('Extract').first().json;\nlet og='';\ntry{\n  const j=$input.first().json;\n  const html=typeof j.data==='string'?j.data:(typeof j.body==='string'?j.body:'');\n  const m=html.match(/property=\"og:title\" content=\"([^\"]{0,300})\"/);\n  if(m)og=m[1].replace(/\\s*\\|\\s*Shopee Thailand\\s*$/,'');\n}catch(e){}\nconst text=info.text+(og?'\\nog:title: '+og:'');\nreturn [{json:{text}}];"
      }
    },
