    {
      "id": "rp",
      "name": "Build Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        -100
      ],
      "parameters": {
        "jsCode": "const page=$input.first().json;\nconst b=$('Build Payload').first().json;\nconst rowUrl=page.url||'';\nlet text;\nif(b.complete){\n  text='✅ เพิ่มดีลแล้ว: '+b.name+'\\n฿'+b.sale+(b.full?' (เต็ม ฿'+b.full+')':'')+' • หมวด '+b.cat+'\\nสถานะ \"ใหม่\" — รอบถัดไปผมเขียนแคปชันมาให้ตรวจครับ';\n}else{\n  text='⚠️ เพิ่มแถวแล้วแต่ข้อมูลไม่ครบ ขาด: '+b.missing.join(', ')+'\\nเปิดแถวเติมข้อมูลแล้วเปลี่ยนสถานะเป็น \"ใหม่\":\\n'+rowUrl+'\\n\\nทริค: แชร์จากแอป Shopee โดยตรง หรือพิมพ์ราคาต่อท้ายลิงก์ เช่น \"เต็ม 900 ลด 300\"';\n}\nreturn [{json:{to:'U72a09a140c06dd099b438153c3b45dd9',messages:[{type:'text',text}]}}];"
      }
    },
