    {
      "id": "ex",
      "name": "Extract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "jsCode": "const b=$input.first().json.body||{};\nconst ev=(b.events||[])[0]||{};\nconst text=(ev.message&&ev.message.type==='text')?ev.message.text:'';\nconst uid=ev.source?ev.source.userId:null;\nconst ok=uid==='U72a09a140c06dd099b438153c3b45dd9';\nconst url=(text.match(/https?:\\/\\/\\S+/)||[null])[0];\nreturn [{json:{text,url,ok,hasUrl:!!(url&&ok)}}];"
      }
    },
    {
      "id": "if1",
