      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "\nconst f=$input.first().json;\nreturn [{json:{\n  parent:{database_id:'589f80403f534993b49fd9fdd4d292ff'},\n  properties:{\n    'สินค้า':{title:[{text:{content:String(f['สินค้า']||'').trim()}}]},\n    'ราคาเต็ม':{number:Number(f['ราคาเต็ม'])||null},\n    'ราคาลด':{number:Number(f['ราคาลด'])||null},\n    'ลิงก์Affiliate':{url:String(f['ลิงก์ Affiliate']||'').trim()||null},\n    'หมวด':{select:{name:f['หมวด']||'อื่นๆ'}},\n    'สถานะ':{select:{name:'ใหม่'}}\n  }\n}}];"
      }
    },
    {
      "id": "h1",
      "name": "Create Notion Row",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
