{
  "name": "Deal Caption Writer — เขียนแคปชัน + อนุมัติอัตโนมัติ (ทุก 3 ชม.)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "50 2-23/3 * * *"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        472
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/databases/589f80403f534993b49fd9fdd4d292ff/query",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"filter\":{\"property\":\"สถานะ\",\"select\":{\"equals\":\"ใหม่\"}},\"page_size\": 10}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Query New Deals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        160
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "U5mfqJ7z2OV1c4PT",
          "name": "Notion Deal Poster (Header Auth)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const res = $json.results || [];\nreturn res.map(p => ({ json: {\n  page_id: p.id,\n  name: (p.properties['สินค้า'].title || []).map(t => t.plain_text).join(''),\n  full: p.properties['ราคาเต็ม'] ? p.properties['ราคาเต็ม'].number : null,\n  sale: p.properties['ราคาลด'] ? p.properties['ราคาลด'].number : null,\n  link: p.properties['ลิงก์Affiliate'] ? p.properties['ลิงก์Affiliate'].url : '',\n  cat: (p.properties['หมวด'] && p.properties['หมวด'].select) ? p.properties['หมวด'].select.name : ''\n}}));"
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Split New",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "REPLACE_ANTHROPIC_API_KEY"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5', max_tokens: 400, messages: [{ role: 'user', content: 'เขียนแคปชันโพสต์ขายดีลภาษาไทย 2-3 บรรทัด มีอีโมจิ น่าสนใจแต่ไม่โอเวอร์ สำหรับสินค้า: ' + $json.name + ' (หมวด ' + $json.cat + ')' + ($json.sale ? (' ราคาปกติ ' + ($json.full || '-') + ' บาท เหลือ ' + $json.sale + ' บาท') : ($json.full ? (' ราคา ' + $json.full + ' บาท') : ' (ไม่ทราบราคา ห้ามกล่าวถึงราคาหรือส่วนลดใด ๆ เด็ดขาด)')) + ' ห้ามแต่งข้อมูลที่ไม่มีจริง ห้ามใส่ลิงก์ ตอบเฉพาะตัวแคปชันเท่านั้น' }] }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Claude Write Caption",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        160
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cap = ($json.content && $json.content[0] && $json.content[0].text ? $json.content[0].text : '').trim();\nconst d = $('Split New').item.json;\nconst pct = d.full && d.sale ? Math.round((1 - d.sale / d.full) * 100) : null;\nlet priceLine = '';\nif (d.sale) priceLine = '💥 เหลือ ' + d.sale + ' บาท' + (pct ? ' (ลด ' + pct + '%)' : '');\nelse if (d.full) priceLine = '💰 ราคา ' + d.full + ' บาท';\nconst body = (priceLine ? priceLine + '\\n' : '') + '👉 ' + d.link;\nconst text = cap + '\\n\\n' + body + '\\n\\n#ป้ายยา #ดีลเด็ด (ลิงก์ affiliate)';\nreturn { json: { page_id: d.page_id, name: d.name, text } };"
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Build Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        160
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.notion.com/v1/pages/{{ $json.page_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ properties: { 'สถานะ': { select: { name: 'อนุมัติแล้ว' } }, 'แคปชัน': { rich_text: [{ text: { content: $json.text.slice(0, 1900) } }] } } }) }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Save Draft to Notion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        160
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "U5mfqJ7z2OV1c4PT",
          "name": "Notion Deal Poster (Header Auth)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/push",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REPLACE_LINE_CHANNEL_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: 'U72a09a140c06dd099b438153c3b45dd9', messages: [{ type: 'text', text: ('📣 ดีลใหม่ — อนุมัติอัตโนมัติแล้ว\\n\\n' + $('Build Caption').item.json.text + '\\n\\n🚀 จะโพสต์ให้เองรอบถัดไป (09/12/15/18/21 น.)\\n🛑 ถ้าไม่อยากให้โพสต์ เปลี่ยนสถานะใน Notion เป็น \"รอตรวจ\" ก่อนถึงรอบ').slice(0, 4900) }] }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "LINE Preview",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1344,
        160
      ],
      "disabled": true
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Query New Deals",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query New Deals": {
      "main": [
        [
          {
            "node": "Split New",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split New": {
      "main": [
        [
          {
            "node": "Claude Write Caption",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Write Caption": {
      "main": [
        [
          {
            "node": "Build Caption",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Caption": {
      "main": [
        [
          {
            "node": "Save Draft to Notion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Draft to Notion": {
      "main": [
        [
          {
            "node": "LINE Preview",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Bangkok",
    "callerPolicy": "workflowsFromSameOwner",
    "saveManualExecutions": true
  }
}
