    {
      "id": "mg",
      "name": "Merge Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        430,
        -160
      ],
      "parameters": {
        "jsCode": "const info=$('Extract').first().json;\nlet og='';\ntry{\n  const j=$input.first().json;\n  const html=typeof j.data==='string'?j.data:(typeof j.body==='string'?j.body:'');\n  const pick=re=>{const m=html.match(re);return m?m[1]:'';};\n  og=pick(/property=\"og:title\"[^>]*content=\"([^\"]{0,300})\"/)\n   ||pick(/content=\"([^\"]{0,300})\"[^>]*property=\"og:title\"/)\n   ||pick(/<title[^>]*>([^<]{0,300})/);\n  og=og.replace(/\\s*\\|\\s*Shopee Thailand\\s*$/,'').replace(/\\s*[|-]\\s*Lazada[^|]*$/i,'').trim();\n}catch(e){}\nconst text=info.text+(og?'\\nog:title: '+og:'');\nreturn [{json:{text}}];"
      }
    },
