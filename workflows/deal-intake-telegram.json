      "parameters": {
        "jsCode": "const i=$input.first().json;\nif(!i.chatId)return [];\nreturn [{json:{chat_id:i.chatId,text:'ส่งลิงก์ดีล Shopee มาได้เลยครับ 🛒\\nแนะนำ: แชร์จากแอป Shopee โดยตรง (มีชื่อสินค้าติดมา) แล้วพิมพ์ราคาต่อท้าย เช่น \"เต็ม 900 ลด 300\" + ใส่ลิงก์ affiliate ของคุณ',disable_web_page_preview:true}}];"
      }
    },
