        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"filter\":{\"and\":[{\"or\":[{\"property\":\"สถานะ\",\"select\":{\"equals\":\"รอตรวจ\"}},{\"property\":\"สถานะ\",\"select\":{\"equals\":\"ใหม่\"}}]},{\"property\":\"ราคาลด\",\"number\":{\"is_empty\":true}}]},\"sorts\":[{\"timestamp\":\"created_time\",\"direction\":\"descending\"}],\"page_size\":1}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "U5mfqJ7z2OV1c4PT",
          "name": "Notion Deal Poster (Header Auth)"
        }
      }
    },
    {
      "id": "ap",
      "name": "Apply Prices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        240
      ],
      "parameters": {
        "jsCode": "const q=$input.first().json;\nconst info=$('Extract').first().json;\nconst nums=(info.text.match(/\\d{1,3}(?:,\\d{3})+|\\d+(?:\\.\\d+)?/g)||[]).map(x=>Number(String(x).replace(/,/g,''))).filter(n=>n>0&&n<1000000);\nconst row=(q.results||[])[0];\nif(!row||!nums.length)return [{json:{doPatch:false}}];\nconst sale=Math.min.apply(null,nums);\nconst full=nums.length>1?Math.max.apply(null,nums):null;\nconst props={'ราคาลด':{number:sale},'สถานะ':{select:{name:'ใหม่'}}};\nif(full&&full!==sale)props['ราคาเต็ม']={number:full};\nconst title=((row.properties['สินค้า']||{}).title||[]).map(t=>t.plain_text).join('');\nreturn [{json:{doPatch:true,pageId:row.id,payload:{properties:props},title,sale,full}}];"
      }
    },
