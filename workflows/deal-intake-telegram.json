{
  "name": "Deal Intake Telegram",
  "nodes": [
    {
      "id": "wh",
      "name": "TG Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "c3d4e5f6-a7b8-4c9d-0e1f-2a3b4c5d6e7f",
      "parameters": {
        "httpMethod": "POST",
        "path": "deal-intake-tg-x7k2",
        "options": {}
      }
    },
    {
      "id": "ex",
      "name": "Extract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "jsCode": "const b=$input.first().json.body||$input.first().json;\nconst msg=b.message||{};\nconst text=msg.text||msg.caption||'';\nconst chatId=msg.chat?msg.chat.id:null;\nconst url=(text.match(/https?:\\/\\/\\S+/)||[null])[0];\nconst source=!url?null:(/tiktok\\.com/i.test(url)?'tiktok':(/lazada\\.|lzd\\.co/i.test(url)?'lazada':(/shopee\\.|shp\\.ee/i.test(url)?'shopee':null)));\nreturn [{json:{text,chatId,url,source,hasUrl:!!(url&&chatId)}}];"
      }
    },
    {
      "id": "if1",
      "name": "Has URL?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.hasUrl }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "cl",
      "name": "Claude Parse",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        620,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "REPLACE_ANTHROPIC_API_KEY"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:\"claude-haiku-4-5\",max_tokens:400,system:\"You extract e-commerce deal info (Shopee, Lazada or TikTok Shop) from a chat message (Thai). The message contains a product link and possibly share-text with product name and prices. Reply with ONLY a JSON object: {\\\"name\\\": string|null (product name, no promo phrases), \\\"full_price\\\": number|null, \\\"sale_price\\\": number|null, \\\"category\\\": one of \\\"gadget\\\",\\\"ความงาม\\\",\\\"บ้าน\\\",\\\"แฟชั่น\\\",\\\"อาหาร\\\",\\\"รถ\\\",\\\"อื่นๆ\\\" (guess from name; \\\"อื่นๆ\\\" if unknown)}. If only one price appears, treat it as sale_price. Do not invent values.\",messages:[{role:\"user\",content:$json.text}]}) }}",
        "options": {}
      }
    },
    {
      "id": "bp",
      "name": "Build Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        -100
      ],
      "parameters": {
        "jsCode": "const resp=$input.first().json;\nlet parsed={};\ntry{const t=(resp.content||[{}])[0].text||'';parsed=JSON.parse((t.match(/\\{[\\s\\S]*\\}/)||['{}'])[0]);}catch(e){}\nconst info=$('Extract').first().json;\nconst name=(parsed.name||'').trim()||null;\nconst full=Number(parsed.full_price)||null;\nconst sale=Number(parsed.sale_price)||null;\nconst cats=['gadget','ความงาม','บ้าน','แฟชั่น','อื่นๆ'];\nconst cat=cats.includes(parsed.category)?parsed.category:'อื่นๆ';\nconst complete=!!name;\nconst props={\n  'สินค้า':{title:[{text:{content:name||('(รอเติมชื่อ) ดีลจาก '+(info.source||'ร้านค้า'))}}]},\n  'ลิงก์Affiliate':{url:info.url},\n  'หมวด':{select:{name:cat}},\n  'สถานะ':{select:{name:complete?'ใหม่':'รอตรวจ'}}\n};\nif(full)props['ราคาเต็ม']={number:full};\nif(sale)props['ราคาลด']={number:sale};\nif(info.source)props['แหล่ง']={select:{name:info.source}};\nconst missing=[];\nif(!name)missing.push('ชื่อสินค้า');\nif(!sale)missing.push('ราคาลด');\nif(!full)missing.push('ราคาเต็ม');\nreturn [{json:{payload:{parent:{database_id:'589f80403f534993b49fd9fdd4d292ff'},properties:props},chatId:info.chatId,name,full,sale,cat,complete,missing,source:info.source}}];"
      }
    },
    {
      "id": "nc",
      "name": "Create Notion Row",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1060,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/pages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "U5mfqJ7z2OV1c4PT",
          "name": "Notion Deal Poster (Header Auth)"
        }
      }
    },
    {
      "id": "rp",
      "name": "Build Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        -100
      ],
      "parameters": {
        "jsCode": "const page=$input.first().json;\nconst b=$('Build Payload').first().json;\nconst rowUrl=page.url||'';\nlet text;\nif(b.complete){\n  text='✅ เพิ่มดีลแล้ว: '+b.name+'\\n฿'+b.sale+(b.full?' (เต็ม ฿'+b.full+')':'')+' • หมวด '+b.cat+'\\nสถานะ \"ใหม่\" — รอบถัดไปบอทเขียนแคปชันส่งเข้า LINE ครับ';\n}else{\n  text='⚠️ เพิ่มแถวแล้วแต่ข้อมูลไม่ครบ ขาด: '+b.missing.join(', ')+'\\nเปิดแถวเติมข้อมูลแล้วเปลี่ยนสถานะเป็น \"ใหม่\":\\n'+rowUrl+'\\n\\n'+(b.source==='tiktok'?'ทริค TikTok: หน้าสินค้า TikTok บล็อกบอต ดึงชื่อ/รูปอัตโนมัติไม่ได้ ต้องพิมพ์ชื่อ+ราคามากับลิงก์ เช่น \"หูฟัง XYZ 590 บาท <ลิงก์>\"':'ทริค: แชร์จากแอป Shopee/Lazada โดยตรง หรือพิมพ์ราคาต่อท้ายลิงก์ เช่น \"เต็ม 900 ลด 300\"');\n}\nreturn [{json:{chat_id:b.chatId,text,disable_web_page_preview:true}}];"
      }
    },
    {
      "id": "ts1",
      "name": "TG Confirm",
      "type": "n8n-nodes-base.httpRequest",
